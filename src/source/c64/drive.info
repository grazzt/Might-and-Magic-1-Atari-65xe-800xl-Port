LABEL { ADDR $0341; NAME "wait_read"; COMMENT "Any job error starts over"; };
LABEL { ADDR $0356; NAME "descramble"; COMMENT "Offsets $01-$EC: swap pages 4/5 XOR $55 and pages 6/7 XOR $AA"; };
LABEL { ADDR $0358; NAME "descramble_byte"; };
LABEL { ADDR $0400; NAME "main"; COMMENT "Idle: blink the LED after an error and wait for the C64 to pull ATN"; };
