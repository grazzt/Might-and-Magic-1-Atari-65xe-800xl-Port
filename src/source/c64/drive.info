LABEL { ADDR $04CA; NAME "step_settle"; };
LABEL { ADDR $04D0; NAME "cmd_protected_read"; COMMENT "Command 4: read track 35 at three head positions, then read"; };
LABEL { ADDR $04D9; NAME "probe_pass"; };
