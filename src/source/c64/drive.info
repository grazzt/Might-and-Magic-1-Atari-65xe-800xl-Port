# 1541 half of the fastloader, as it runs at $0300-$07FF in drive RAM.
# Stored on every side in track 18, sectors 7-11. Sector 7 is started by the
# DOS command B-E,2,0,18,7; it reads sectors 8-11 into $0400-$07FF, unscrambles
# them (descramble below; tools/rebuild_loader.py applies the inverse) and
# jumps to $0400. This file describes the unscrambled image.
GLOBAL { STARTADDR $0300; CPU "6502"; COMMENTS 0; };

RANGE { START $0380; END $03FF; TYPE ByteTable; NAME "sector7_unused"; COMMENT "never executed or read"; };
RANGE { START $0769; END $078B; TYPE ByteTable; NAME "sectors_per_track"; COMMENT "tracks 1-35, indexed from sectors_base"; };
RANGE { START $078C; END $079C; TYPE ByteTable; NAME "order_17"; COMMENT "sector order on a 17-sector track"; };
RANGE { START $079D; END $07AE; TYPE ByteTable; NAME "order_18"; };
RANGE { START $07AF; END $07C1; TYPE ByteTable; NAME "order_19"; };
RANGE { START $07C2; END $07D6; TYPE ByteTable; NAME "order_21"; };
RANGE { START $07D7; END $07DB; TYPE ByteTable; NAME "order_table_lo"; COMMENT "for 17, 18, 19, (20), 21 sectors"; };
RANGE { START $07DC; END $07E0; TYPE ByteTable; NAME "order_table_hi"; };
RANGE { START $07E1; END $07E6; TYPE ByteTable; NAME "command_lo"; COMMENT "commands 0-5"; };
RANGE { START $07E7; END $07EC; TYPE ByteTable; NAME "command_hi"; };
RANGE { START $07ED; END $07FF; TYPE ByteTable; NAME "copyright"; COMMENT "(c)1986 Activision"; };

