# C64 half of the fastloader: pages 4-6 of ACTIVISION INC., copied to
# $9D00-$9FFF. The game fills the parameter block and calls the jump table.
# Every routine returns the drive status in A (0 = good) with Z set to match.
GLOBAL { STARTADDR $9D00; CPU "6502"; COMMENTS 0; };

RANGE { START $9D00; END $9D01; TYPE AddrTable; NAME "param_address"; COMMENT "C64 address of the data"; };
RANGE { START $9D02; END $9D03; TYPE WordTable; NAME "param_length"; COMMENT "byte count; the two disk ID bytes for command 2"; };
RANGE { START $9D04; END $9D04; TYPE ByteTable; NAME "param_offset"; COMMENT "first byte within the first block"; };
RANGE { START $9D05; END $9D06; TYPE WordTable; NAME "param_block"; COMMENT "logical block number"; };
RANGE { START $9D1F; END $9D20; TYPE ByteTable; NAME "unused_9d1f"; };
RANGE { START $9D21; END $9D21; TYPE ByteTable; NAME "shift"; };
RANGE { START $9D22; END $9D22; TYPE ByteTable; NAME "port_idle"; COMMENT "CIA2 port A with only the VIC bank bits"; };
RANGE { START $9D23; END $9D23; TYPE ByteTable; NAME "port_clock"; COMMENT "idle + CLK out"; };
RANGE { START $9D24; END $9D24; TYPE ByteTable; NAME "port_atn"; COMMENT "idle + ATN out"; };
RANGE { START $9D25; END $9D25; TYPE ByteTable; NAME "port_atn_clock"; COMMENT "idle + ATN and CLK out"; };
RANGE { START $9D88; END $9D8A; TYPE ByteTable; NAME "dos_buffer"; COMMENT "#0: channel 2 uses drive buffer 0, $0300"; };
RANGE { START $9D8B; END $9D97; TYPE ByteTable; NAME "dos_execute"; COMMENT "B-E,2,0,18,7: load track 18 sector 7 into it and run it"; };
RANGE { START $9D98; END $9D99; TYPE ByteTable; NAME "dos_string_lo"; };
RANGE { START $9D9A; END $9D9B; TYPE ByteTable; NAME "dos_string_hi"; };
RANGE { START $9FD7; END $9FFF; TYPE ByteTable; NAME "padding"; };

LABEL { ADDR $9D07; NAME "entry_init"; };
LABEL { ADDR $9D0A; NAME "entry_set_bank"; };
LABEL { ADDR $9D0D; NAME "entry_read"; };
LABEL { ADDR $9D10; NAME "entry_write"; COMMENT "BRK instead of JMP when the disk check failed"; };
LABEL { ADDR $9D13; NAME "entry_set_disk_id"; };
LABEL { ADDR $9D16; NAME "entry_get_disk_id"; };
LABEL { ADDR $9D19; NAME "entry_protected_read"; };
LABEL { ADDR $9D1C; NAME "entry_reset_drive"; };
LABEL { ADDR $9D26; NAME "init"; COMMENT "Start the drive code with DOS commands, then wait for it on the bus"; };
LABEL { ADDR $9D4B; NAME "wait_clock_low"; };
LABEL { ADDR $9D50; NAME "wait_clock_high"; };
LABEL { ADDR $9D5C; NAME "send_dos_string"; COMMENT "X = string number, Y = secondary address"; };
LABEL { ADDR $9D71; NAME "next_dos_char"; };
LABEL { ADDR $9D84; NAME "dos_string_done"; };
LABEL { ADDR $9D9C; NAME "set_disk_id"; COMMENT "Command 2: X, Y = ID bytes for the DOS to expect"; };
LABEL { ADDR $9DA8; NAME "get_disk_id"; COMMENT "Command 3: returns the ID in the sector headers in X, Y"; };
LABEL { ADDR $9DC2; NAME "protected_read"; COMMENT "Command 4"; };
LABEL { ADDR $9DC6; NAME "read"; COMMENT "Command 0"; };
LABEL { ADDR $9DC8; NAME "read_common"; };
LABEL { ADDR $9DD1; NAME "read_page"; };
LABEL { ADDR $9DDF; NAME "read_tail"; };
LABEL { ADDR $9DE3; NAME "read_tail_byte"; };
LABEL { ADDR $9DED; NAME "read_done"; };
LABEL { ADDR $9DF0; NAME "exchange_status"; COMMENT "Send checksum A; receive the drive status twice"; };
LABEL { ADDR $9E02; NAME "status_agrees"; };
LABEL { ADDR $9E05; NAME "write"; COMMENT "Command 1"; };
LABEL { ADDR $9E10; NAME "write_page"; };
LABEL { ADDR $9E1E; NAME "write_tail"; };
LABEL { ADDR $9E22; NAME "write_tail_byte"; };
LABEL { ADDR $9E2C; NAME "write_done"; };
LABEL { ADDR $9E32; NAME "reset_drive"; COMMENT "Command 5"; };
LABEL { ADDR $9E3A; NAME "set_bank"; COMMENT "A = CIA2 port A value; keeps its VIC bank bits for all bus traffic"; };
LABEL { ADDR $9E66; NAME "attention_retry"; COMMENT "Ten tries, then return $FF to the game"; };
LABEL { ADDR $9E74; NAME "send_command"; COMMENT "A = command; sends it and the five parameter bytes"; };
LABEL { ADDR $9E77; NAME "send_command_again"; };
LABEL { ADDR $9E82; NAME "attention"; COMMENT "Wake the drive: ATN pulse, then $28 bit by bit; the drive reads it inverted as $D7"; };
LABEL { ADDR $9E8F; NAME "attention_hold"; };
LABEL { ADDR $9E9D; NAME "attention_wait"; };
LABEL { ADDR $9EAA; NAME "attention_bit"; };
LABEL { ADDR $9EC4; NAME "attention_bit_one"; };
LABEL { ADDR $9EC7; NAME "attention_bit_out"; };
LABEL { ADDR $9EDE; NAME "attention_ack"; };
LABEL { ADDR $9EFF; NAME "send_parameter"; };
LABEL { ADDR $9F13; NAME "command_accepted"; COMMENT "Copy address and length to $FC-$FF, clear both checksums"; };
LABEL { ADDR $9F15; NAME "copy_parameter"; };
LABEL { ADDR $9F27; NAME "send_byte"; COMMENT "A = byte; adds it to the send checksum"; };
LABEL { ADDR $9F33; NAME "send_wait_drive"; };
LABEL { ADDR $9F38; NAME "send_bit"; };
LABEL { ADDR $9F40; NAME "send_bit_zero"; };
LABEL { ADDR $9F43; NAME "send_bit_out"; };
LABEL { ADDR $9F50; NAME "send_checksum"; };
LABEL { ADDR $9F5F; NAME "receive_byte"; COMMENT "Returns a byte in A; adds it to the receive checksum"; };
LABEL { ADDR $9F68; NAME "receive_wait_drive"; };
LABEL { ADDR $9FCC; NAME "delay_rts"; };
LABEL { ADDR $9FCD; NAME "shift_load_idle"; };
LABEL { ADDR $9FD2; NAME "shift_load_clock"; };

LABEL { ADDR $9D72; NAME "dos_string_pointer"; SIZE 2; };
LABEL { ADDR $9DBE; NAME "disk_id_first"; };
LABEL { ADDR $9DFD; NAME "status_first"; };
LABEL { ADDR $9EF8; NAME "command_number"; };
LABEL { ADDR $9F53; NAME "send_sum"; COMMENT "8-bit sum of bytes sent"; };
LABEL { ADDR $9FBD; NAME "receive_invert"; COMMENT "undoes the line polarity and bank bits in the sampled port value"; };
LABEL { ADDR $9FC3; NAME "receive_sum"; COMMENT "8-bit sum of bytes received"; };
LABEL { ADDR $9FC8; NAME "receive_value"; };

LABEL { ADDR $FC; NAME "data_pointer"; SIZE 2; };
LABEL { ADDR $FE; NAME "bytes_left"; SIZE 2; };
LABEL { ADDR $DD00; NAME "CIA2_PRA"; COMMENT "bits 0-1 VIC bank, 3 ATN out, 4 CLK out, 5 DATA out, 6 CLK in, 7 DATA in"; };
LABEL { ADDR $DD02; NAME "CIA2_DDRA"; };
LABEL { ADDR $FF93; NAME "SECOND"; };
LABEL { ADDR $FFA8; NAME "CIOUT"; };
LABEL { ADDR $FFAE; NAME "UNLSN"; };
LABEL { ADDR $FFB1; NAME "LISTEN"; };
LABEL { ADDR $FFE7; NAME "CLALL"; };
